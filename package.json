{
  "name": "defi-vending-machine-1155",
  "version": "1.0.0",
  "description": "DeFi Vending Machine ERC-1155 Smart Contract & 30 Meme Cards Pipeline",
  "main": "card_showcase.html",
  "scripts": {
    "test": "node test/vending_machine.test.js && node test/pinata_upload.test.js",
    "generate:cards": "python3 scripts/generate_cards.py",
    "generate:back": "python3 scripts/generate_card_back.py",
    "generate:poster": "python3 scripts/generate_poster.py",
    "generate:metadata": "node scripts/generate_metadata.js",
    "serve": "npx serve .",
    "upload:pinata": "node scripts/pinata_upload.js",
    "test:contract": "hardhat test",
    "test:all": "npm test && hardhat test",
    "wallet:new": "node scripts/wallet.js new",
    "wallet:import": "node scripts/wallet.js import",
    "wallet:address": "node scripts/wallet.js address",
    "wallet:balance": "node scripts/wallet.js balance",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:dry": "DEPLOY_DRY=1 hardhat run scripts/deploy.js --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "keywords": [
    "defi",
    "smart-contracts",
    "erc-1155",
    "vending-machine",
    "ethereum",
    "sepolia"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.2"
  }
}
